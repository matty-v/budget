# Plaid API Configuration
# Get your credentials at https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_key_here

# Environment: sandbox, development, or production
# Use sandbox for testing with fake credentials
PLAID_ENV=sandbox

# Server port (optional, defaults to 3001)
PLAID_SERVER_PORT=3001
